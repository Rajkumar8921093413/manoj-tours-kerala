# For local MySQL 8.0 / custom: set DB_PASSWORD accordingly
# For Hostinger: DB_HOST=localhost, DB_USER=u123456789_user, DB_PASSWORD=..., DB_NAME=u123456789_manoj
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Manoj

